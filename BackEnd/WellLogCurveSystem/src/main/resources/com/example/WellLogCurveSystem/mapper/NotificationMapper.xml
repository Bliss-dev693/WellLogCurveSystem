<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.WellLogCurveSystem.mapper.NotificationMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.example.WellLogCurveSystem.entity.Notification">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="type" property="type"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 分页查询通知列表 -->
    <select id="selectByCondition" parameterType="com.example.WellLogCurveSystem.entity.Notification" resultMap="BaseResultMap">
        SELECT * FROM notification
        WHERE user_id = #{userId}
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 批量标记已读 -->
    <update id="batchUpdateStatus">
        UPDATE notification
        SET status = #{status}, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND user_id = #{userId}
    </update>

    <!-- 批量删除 -->
    <delete id="batchDelete">
        DELETE FROM notification
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND user_id = #{userId}
    </delete>

</mapper>